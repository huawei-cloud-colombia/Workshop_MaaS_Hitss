# Workshop 02 — AI Agent Configuration
# Copy this file to .env and fill in your values

# URL base del endpoint compatible con OpenAI
AGENT_API_URL=https://your-api-endpoint.com/v1

# API key para autenticarse con el modelo
AGENT_API_KEY=your-api-key-here

# Nombre del modelo a utilizar
AGENT_MODEL_NAME=glm-5.2
